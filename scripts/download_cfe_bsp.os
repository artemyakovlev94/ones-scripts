Перем ЗвукЗавершения;
Перем ВоспроизводитьЗвукЗавершения;

Процедура ВыполнитьСкрипт()

КаталогСценария = ТекущийСценарий().Каталог;
КореньПроекта = ОбъединитьПути(КаталогСценария, "..");

ПодключитьСценарий(
	ОбъединитьПути(КореньПроекта, "src", "lib", "env.os"),
	"ПараметрыОкружения"
);

Окружение = Новый ПараметрыОкружения();
Окружение.Прочитать();
ВоспроизводитьЗвукЗавершения = ЗвукЗавершения.ПолучитьПризнак(
	ПолучитьПеременнуюСреды("PLAY_COMPLETION_SOUND")
);

ПодключитьСценарий(
	ОбъединитьПути(КореньПроекта, "src", "lib", "logger.os"),
	"Логирование"
);

ПодключитьСценарий(
	ОбъединитьПути(КореньПроекта, "src", "workflows", "download_cfe_bsp.os"),
	"ЗагрузкаCFEBSP"
);

Workflow = Новый ЗагрузкаCFEBSP();
Workflow.Запустить(
	ПолучитьПеременнуюСреды("BSP_CFE_ARCHIVE_URL"),
	ОбъединитьПути(КореньПроекта, ".temp"),
	"bsp.cfe"
);

Лог = Новый Логирование();
Лог.Вывести("Файл CFE успешно скачан и сохранён.");

КонецПроцедуры

КаталогСценарияЗвука = ТекущийСценарий().Каталог;
КореньПроектаЗвука = ОбъединитьПути(КаталогСценарияЗвука, "..");
ПодключитьСценарий(ОбъединитьПути(КореньПроектаЗвука, "src", "lib", "logger.os"), "Логирование");
ПодключитьСценарий(ОбъединитьПути(КореньПроектаЗвука, "src", "lib", "process.os"), "ЗапускПроцессов");
ПодключитьСценарий(ОбъединитьПути(КореньПроектаЗвука, "src", "lib", "completion_sound.os"), "ЗвуковоеУведомление");
ЗвукЗавершения = Новый ЗвуковоеУведомление();
ВоспроизводитьЗвукЗавершения = Ложь;
Попытка
	ВыполнитьСкрипт();
	ЗвукЗавершения.Воспроизвести(ВоспроизводитьЗвукЗавершения);
Исключение
	ТекстОшибки = ОписаниеОшибки();
	ЗвукЗавершения.Воспроизвести(ВоспроизводитьЗвукЗавершения, Истина);
	ВызватьИсключение ТекстОшибки;
КонецПопытки;
