КаталогСценария = ТекущийСценарий().Каталог;
КореньПроекта = ОбъединитьПути(КаталогСценария, "..");

ПодключитьСценарий(ОбъединитьПути(КореньПроекта, "src", "lib", "env.os"), "ПараметрыОкружения");
Окружение = Новый ПараметрыОкружения();
Окружение.Прочитать();

ПодключитьСценарий(ОбъединитьПути(КореньПроекта, "src", "lib", "arguments.os"), "АргументыСкриптов");
ПодключитьСценарий(ОбъединитьПути(КореньПроекта, "src", "workflows", "create_or_update_database.os"), "СозданиеИОбновлениеБазыДанных");

ОжидаемыеИмена = Новый Массив;
ОжидаемыеИмена.Добавить("--db-name");
ОжидаемыеИмена.Добавить("--db-path");
ОжидаемыеИмена.Добавить("--worktree-name");
ОжидаемыеИмена.Добавить("--worktree-path");
ОжидаемыеИмена.Добавить("--extension-name");
ОжидаемыеИмена.Добавить("--extension-path");

ПовторяемыеИмена = Новый Массив;
ПовторяемыеИмена.Добавить("--extension-name");
ПовторяемыеИмена.Добавить("--extension-path");

ПарсерАргументов = Новый АргументыСкриптов();
Параметры = ПарсерАргументов.ПрочитатьИменованныеПараметры(
	АргументыКоманднойСтроки,
	ОжидаемыеИмена,
	ПовторяемыеИмена
);

ИмяWorktree = Параметры.Получить("worktree-name");
ПутьWorktree = Параметры.Получить("worktree-path");
ИмяБазы = Параметры.Получить("db-name");
ПутьКБазе = Параметры.Получить("db-path");
ИменаРасширений = Параметры.Получить("extension-name");
ПутиРасширений = Параметры.Получить("extension-path");

Если ИменаРасширений = Неопределено Тогда
	ИменаРасширений = Новый Массив;
КонецЕсли;
Если ПутиРасширений = Неопределено Тогда
	ПутиРасширений = Новый Массив;
КонецЕсли;
Если ИменаРасширений.Количество() <> ПутиРасширений.Количество() Тогда
	ВызватьИсключение "Количество параметров --extension-name и --extension-path должно совпадать";
КонецЕсли;

Расширения = Новый Массив;
Для ИндексРасширения = 0 По ИменаРасширений.ВГраница() Цикл
	Расширения.Добавить(Новый Структура(
		"name,path",
		ИменаРасширений[ИндексРасширения],
		ПутиРасширений[ИндексРасширения]
	));
КонецЦикла;

ПараметрыСреды = Новый Структура;
ПараметрыСреды.Вставить("ONE_C_BASES_PATH", ПолучитьПеременнуюСреды("ONE_C_BASES_PATH"));
ПараметрыСреды.Вставить("ONE_C_PLATFORM_VERSION", ПолучитьПеременнуюСреды("ONE_C_PLATFORM_VERSION"));
ПараметрыСреды.Вставить("ONE_C_PLATFORM_BITNESS", ПолучитьПеременнуюСреды("ONE_C_PLATFORM_BITNESS"));
ПараметрыСреды.Вставить("ONE_C_IBASES_FOLDER", ПолучитьПеременнуюСреды("ONE_C_IBASES_FOLDER"));
ПараметрыСреды.Вставить("ONE_C_INFOBASE_USER", ПолучитьПеременнуюСреды("ONE_C_INFOBASE_USER"));
ПараметрыСреды.Вставить("ONE_C_INFOBASE_PASSWORD", ПолучитьПеременнуюСреды("ONE_C_INFOBASE_PASSWORD"));
ПараметрыСреды.Вставить("WORKTREE_PATH_CF", ПолучитьПеременнуюСреды("WORKTREE_PATH_CF"));
ПараметрыСреды.Вставить("WORKTREE_PATH_CFE_TEST", ПолучитьПеременнуюСреды("WORKTREE_PATH_CFE_TEST"));

Workflow = Новый СозданиеИОбновлениеБазыДанных();
Workflow.Запустить(
	ИмяWorktree,
	ПутьWorktree,
	ИмяБазы,
	ПутьКБазе,
	ПараметрыСреды,
	Расширения,
	КореньПроекта
);
