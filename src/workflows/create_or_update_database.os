#Область ПрограммныйИнтерфейс

// Создаёт новую или обновляет существующую файловую базу worktree, подключает расширения и запускает клиент.
Процедура Запустить(ИмяWorktree, ПутьWorktree, ИмяБазы, ПутьКБазе, ПараметрыОкружения, Расширения, КореньПроекта) Экспорт

	ЗапуститьВнутренний(
		ИмяWorktree,
		ПутьWorktree,
		ИмяБазы,
		ПутьКБазе,
		ПараметрыОкружения,
		Расширения,
		КореньПроекта,
		""
	);

КонецПроцедуры

Процедура ЗапуститьВнутренний(
	ИмяWorktree,
	ПутьWorktree,
	ИмяБазы,
	ПутьКБазе,
	ПараметрыОкружения,
	Расширения,
	КореньПроекта,
	ПутьКБазеДляСоздания
)

	ПодключитьЗависимости();
	ОперацииБазы = Новый ОперацииСБазой1С();
	ПоказыватьОкна = ПолучитьПризнакОтображенияОкон(ПараметрыОкружения);
	ПроверитьПараметры(ИмяWorktree, ПутьWorktree, ПутьКБазе, ПараметрыОкружения, КореньПроекта);
	ИспользоватьБазуДляСоздания = Не ПустаяСтрока(ПутьКБазеДляСоздания);
	Если ИспользоватьБазуДляСоздания Тогда
		ПутьКФайлуБазыДляСоздания = ПроверитьБазуДляСоздания(ПутьКБазеДляСоздания);
	КонецЕсли;

	ИмяБазыПередано = Не ПустаяСтрока(ИмяБазы);
	Если ПустаяСтрока(ИмяБазы) Тогда
		ИмяБазы = ИмяWorktree;
	КонецЕсли;
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ПутьКБазе = ОбъединитьПути(ПараметрыОкружения.ONE_C_BASES_PATH, ИмяWorktree);
	КонецЕсли;
	ПроверитьЗаполнение(ИмяБазы, "Не удалось определить имя базы данных");
	ПроверитьЗаполнение(ПутьКБазе, "Не удалось определить путь к базе данных");
	ПутьККонфигурации = ОбъединитьПути(ПутьWorktree, ПараметрыОкружения.WORKTREE_PATH_CF);
	ПутьКТестовомуРасширению = ОбъединитьПути(ПутьWorktree, ПараметрыОкружения.WORKTREE_PATH_CFE_TEST);
	ПроверитьКаталог(ПутьККонфигурации, "исходников конфигурации");
	ПроверитьКаталог(ПутьКТестовомуРасширению, "исходников тестового расширения");
	ПроверитьФайлыРасширений(Расширения);

	Если ИспользоватьБазуДляСоздания Тогда
		ПутьКФайлуЦелевойБазы = ОбъединитьПути(ПутьКБазе, "1Cv8.1CD");
		Если Не ФайлБазыСуществует(ПутьКФайлуЦелевойБазы) Тогда
			СкопироватьБазуДляСоздания(ПутьКФайлуБазыДляСоздания, ПутьКБазе);
		КонецЕсли;
		БазаСуществует = Истина;
	Иначе
		БазаСуществует = КаталогСуществует(ПутьКБазе);
		Если Не БазаСуществует Тогда
			ОперацииБазы.СоздатьИзИсходников(ПутьКБазе, ПутьККонфигурации, ПараметрыОкружения.ONE_C_PLATFORM_VERSION, ПараметрыОкружения.ONE_C_PLATFORM_BITNESS, ПоказыватьОкна);
		КонецЕсли;
	КонецЕсли;
	ОбеспечитьЗаписьВСпискеБаз(
		ИмяWorktree,
		ИмяБазы,
		ПутьКБазе,
		ПараметрыОкружения.ONE_C_IBASES_FOLDER,
		ИмяБазыПередано
	);

	Авторизация = ПолучитьАвторизацию(БазаСуществует, ПараметрыОкружения);
	Если БазаСуществует Тогда
		ОперацииБазы.ЗагрузитьКонфигурацию(
			ПутьКБазе,
			ПутьККонфигурации,
			ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
			ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
			Авторизация,
			ПоказыватьОкна
		);
	КонецЕсли;

	ЗагрузитьТестовоеРасширение(
		ИмяWorktree,
		ПутьКБазе,
		ПутьКТестовомуРасширению,
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		Авторизация,
		КореньПроекта,
		ПоказыватьОкна
	);
	ЗагрузитьПереданныеРасширения(
		ПутьКБазе,
		Расширения,
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		Авторизация,
		ПоказыватьОкна
	);
	ОперацииБазы.ЗапуститьКлиент(ПутьКБазе, ПараметрыОкружения.ONE_C_PLATFORM_VERSION, ПараметрыОкружения.ONE_C_PLATFORM_BITNESS, Авторизация, ПоказыватьОкна);

КонецПроцедуры

// Создаёт отсутствующую целевую базу копированием файла существующей базы и обновляет её.
Процедура ЗапуститьИзБазыДляСоздания(
	ИмяWorktree,
	ПутьWorktree,
	ИмяБазы,
	ПутьКБазе,
	ПараметрыОкружения,
	Расширения,
	КореньПроекта,
	ПутьКБазеДляСоздания
) Экспорт

	ПроверитьЗаполнение(
		ПутьКБазеДляСоздания,
		"Не задана переменная ONE_C_BASES_TEMPLATE"
	);
	ЗапуститьВнутренний(
		ИмяWorktree,
		ПутьWorktree,
		ИмяБазы,
		ПутьКБазе,
		ПараметрыОкружения,
		Расширения,
		КореньПроекта,
		ПутьКБазеДляСоздания
	);

КонецПроцедуры

// Собирает и загружает только тестовое расширение в существующую файловую базу.
Процедура ЗагрузитьТестовоеРасширениеВСуществующуюБазу(
	ИмяWorktree,
	ПутьWorktree,
	ПутьКБазе,
	ПараметрыОкружения,
	КореньПроекта
) Экспорт

	ПодключитьЗависимости();
	ПоказыватьОкна = ПолучитьПризнакОтображенияОкон(ПараметрыОкружения);
	ПроверитьЗаполнение(ИмяWorktree, "Не задан обязательный параметр --worktree-name");
	ПроверитьЗаполнение(ПутьWorktree, "Не задан обязательный параметр --worktree-path");
	ПроверитьЗаполнение(КореньПроекта, "Не задан корень проекта скриптов");
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ПроверитьЗаполнение(
			ПараметрыОкружения.ONE_C_BASES_PATH,
			"Не задан параметр --db-path и переменная ONE_C_BASES_PATH"
		);
		ПутьКБазе = ОбъединитьПути(ПараметрыОкружения.ONE_C_BASES_PATH, ИмяWorktree);
	КонецЕсли;

	ПроверитьЗаполнение(
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		"Не задана переменная ONE_C_PLATFORM_VERSION"
	);
	ПроверитьЗаполнение(
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		"Не задана переменная ONE_C_PLATFORM_BITNESS"
	);
	ПараметрыОкружения.ONE_C_PLATFORM_BITNESS = НРег(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьРазрядность(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьЗаполнение(
		ПараметрыОкружения.WORKTREE_PATH_CFE_TEST,
		"Не задана переменная WORKTREE_PATH_CFE_TEST"
	);

	ПутьКФайлуБазы = ОбъединитьПути(ПутьКБазе, "1Cv8.1CD");
	Если Не ФайлБазыСуществует(ПутьКФайлуБазы) Тогда
		ВызватьИсключение "Не найдена существующая информационная база 1С: " + ПутьКФайлуБазы;
	КонецЕсли;

	ПутьКТестовомуРасширению = ОбъединитьПути(
		ПутьWorktree,
		ПараметрыОкружения.WORKTREE_PATH_CFE_TEST
	);
	ПроверитьКаталог(ПутьКТестовомуРасширению, "исходников тестового расширения");
	Авторизация = ПолучитьАвторизацию(Истина, ПараметрыОкружения);
	ЗагрузитьТестовоеРасширение(
		ИмяWorktree,
		ПутьКБазе,
		ПутьКТестовомуРасширению,
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		Авторизация,
		КореньПроекта,
		ПоказыватьОкна
	);

КонецПроцедуры

Функция ПроверитьБазуДляСоздания(ПутьКБазеДляСоздания)

	ПроверитьЗаполнение(
		ПутьКБазеДляСоздания,
		"Не задана переменная ONE_C_BASES_TEMPLATE"
	);
	ПутьКФайлуБазы = ОбъединитьПути(ПутьКБазеДляСоздания, "1Cv8.1CD");
	Если Не ФайлБазыСуществует(ПутьКФайлуБазы) Тогда
		ВызватьИсключение "В каталоге ONE_C_BASES_TEMPLATE не найден файл 1Cv8.1CD: "
			+ ПутьКБазеДляСоздания;
	КонецЕсли;
	Возврат ПутьКФайлуБазы;

КонецФункции

Функция ФайлБазыСуществует(ПутьКФайлуБазы)

	ФайлБазы = Новый Файл(ПутьКФайлуБазы);
	Возврат ФайлБазы.Существует() И Не ФайлБазы.ЭтоКаталог();

КонецФункции

Процедура СкопироватьБазуДляСоздания(ПутьКИсходномуФайлуБазы, ПутьКБазе)

	Файлы = Новый РаботаСФайлами();
	Файлы.СкопироватьСКонечнымИменем(ПутьКИсходномуФайлуБазы, ПутьКБазе, "1Cv8.1CD");

КонецПроцедуры

Функция ПолучитьАвторизацию(БазаСуществует, ПараметрыОкружения)

	Авторизация = Новый Структура("Использовать,Пользователь,Пароль", Ложь, "", "");
	Если Не БазаСуществует Тогда
		Возврат Авторизация;
	КонецЕсли;

	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_INFOBASE_USER, "Не задана переменная ONE_C_INFOBASE_USER для существующей базы");
	Авторизация.Использовать = Истина;
	Авторизация.Пользователь = ПараметрыОкружения.ONE_C_INFOBASE_USER;
	Если ПараметрыОкружения.ONE_C_INFOBASE_PASSWORD <> Неопределено Тогда
		Авторизация.Пароль = ПараметрыОкружения.ONE_C_INFOBASE_PASSWORD;
	КонецЕсли;
	Возврат Авторизация;

КонецФункции

#КонецОбласти

#Область Подготовка

Процедура ПодключитьЗависимости()

	КаталогWorkflow = ТекущийСценарий().Каталог;
	КаталогБиблиотек = ОбъединитьПути(КаталогWorkflow, "..", "lib");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "logger.os"), "Логирование");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "process.os"), "ЗапускПроцессов");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "files.os"), "РаботаСФайлами");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "ibases.os"), "СписокИнформационныхБаз");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "one_c_database.os"), "ОперацииСБазой1С");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "one_c_extensions.os"), "ОперацииСРасширениями1С");

КонецПроцедуры

Функция ПолучитьПризнакОтображенияОкон(ПараметрыОкружения)

	Значение = Неопределено;
	Если Не ПараметрыОкружения.Свойство("SHOW_COMMAND_WINDOWS", Значение)
		Или ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;

	НормализованноеЗначение = НРег(СокрЛП(Строка(Значение)));
	Если НормализованноеЗначение = "true" Или НормализованноеЗначение = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если НормализованноеЗначение = "false" Или НормализованноеЗначение = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	ВызватьИсключение "Недопустимое значение SHOW_COMMAND_WINDOWS: " + Строка(Значение)
		+ ". Допустимы true, false, 1 или 0";

КонецФункции

Процедура ПроверитьПараметры(ИмяWorktree, ПутьWorktree, ПутьКБазе, ПараметрыОкружения, КореньПроекта)

	ПроверитьЗаполнение(ИмяWorktree, "Не задан обязательный параметр --worktree-name");
	ПроверитьЗаполнение(ПутьWorktree, "Не задан обязательный параметр --worktree-path");
	ПроверитьЗаполнение(КореньПроекта, "Не задан корень проекта скриптов");
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_BASES_PATH, "Не задан параметр --db-path и переменная ONE_C_BASES_PATH");
	КонецЕсли;
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_PLATFORM_VERSION, "Не задана переменная ONE_C_PLATFORM_VERSION");
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS, "Не задана переменная ONE_C_PLATFORM_BITNESS");
	ПараметрыОкружения.ONE_C_PLATFORM_BITNESS = НРег(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьРазрядность(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_IBASES_FOLDER, "Не задана переменная ONE_C_IBASES_FOLDER");
	ПроверитьЗаполнение(ПараметрыОкружения.WORKTREE_PATH_CF, "Не задана переменная WORKTREE_PATH_CF");
	ПроверитьЗаполнение(ПараметрыОкружения.WORKTREE_PATH_CFE_TEST, "Не задана переменная WORKTREE_PATH_CFE_TEST");

КонецПроцедуры

Процедура ПроверитьРазрядность(Разрядность)

	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить("x64");
	ДопустимыеЗначения.Добавить("x86");
	ДопустимыеЗначения.Добавить("x64x86");
	ДопустимыеЗначения.Добавить("x86x64");
	Если ДопустимыеЗначения.Найти(НРег(Разрядность)) = Неопределено Тогда
		ВызватьИсключение "Недопустимое значение ONE_C_PLATFORM_BITNESS: " + Разрядность;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаполнение(Значение, ТекстОшибки)

	Если Значение = Неопределено Или ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКаталог(Путь, Описание)

	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Или Не Файл.ЭтоКаталог() Тогда
		ВызватьИсключение СтрШаблон("Не найден каталог %1: %2", Описание, Путь);
	КонецЕсли;

КонецПроцедуры

Функция КаталогСуществует(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();

КонецФункции

#КонецОбласти

#Область РаботаСРасширениями

Процедура ЗагрузитьТестовоеРасширение(ИмяWorktree, ПутьКБазе, ПутьКИсходникам, ВерсияПлатформы, Разрядность, Авторизация, КореньПроекта, ПоказыватьОкна)

	ОперацииРасширений = Новый ОперацииСРасширениями1С();
	ИмяРасширения = ОперацииРасширений.ПрочитатьИмяИзИсходников(ПутьКИсходникам);
	ВременныйКаталог = ОбъединитьПути(КореньПроекта, ".temp");
	Файлы = Новый РаботаСФайлами();
	Файлы.ОбеспечитьКаталог(ВременныйКаталог);
	ПутьКCFE = ОбъединитьПути(ВременныйКаталог, ИмяWorktree + "-tests.cfe");

	Попытка
		ОперацииРасширений.СобратьВCFE(ПутьКБазе, ПутьКИсходникам, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, ПоказыватьОкна);
		ОперацииРасширений.ЗагрузитьИзCFE(ПутьКБазе, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, ПоказыватьОкна);
		ОперацииРасширений.ОтключитьОграничения(ПутьКБазе, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, Истина, ПоказыватьОкна);
	Исключение
		ОперацииРасширений.УдалитьCFE(ПутьКCFE);
		ВызватьИсключение;
	КонецПопытки;
	ОперацииРасширений.УдалитьCFE(ПутьКCFE);

КонецПроцедуры

Процедура ЗагрузитьПереданныеРасширения(ПутьКБазе, Расширения, ВерсияПлатформы, Разрядность, Авторизация, ПоказыватьОкна)

	ОперацииРасширений = Новый ОперацииСРасширениями1С();
	Для Каждого Расширение Из Расширения Цикл
		ОперацииРасширений.ЗагрузитьИзCFE(ПутьКБазе, Расширение.path, Расширение.name, ВерсияПлатформы, Разрядность, Авторизация, ПоказыватьОкна);
		ОперацииРасширений.ОтключитьОграничения(ПутьКБазе, Расширение.name, ВерсияПлатформы, Разрядность, Авторизация, Ложь, ПоказыватьОкна);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьФайлыРасширений(Расширения)

	Для Каждого Расширение Из Расширения Цикл
		ПроверитьЗаполнение(Расширение.name, "Не заполнен параметр --extension-name");
		ПроверитьЗаполнение(Расширение.path, "Не заполнен параметр --extension-path");
		ФайлРасширения = Новый Файл(Расширение.path);
		Если Не ФайлРасширения.Существует() Или ФайлРасширения.ЭтоКаталог() Тогда
			ВызватьИсключение СтрШаблон("Не найден файл расширения %1: %2", Расширение.name, Расширение.path);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РегистрацияИЗапуск

Процедура ОбеспечитьЗаписьВСпискеБаз(ИмяWorktree, ИмяБазы, ПутьКБазе, ИмяКорневойПапки, ИмяБазыПередано)

	КаталогAppData = ПолучитьПеременнуюСреды("APPDATA");
	ПроверитьЗаполнение(КаталогAppData, "Не определена системная переменная APPDATA");
	КаталогСпискаБаз = ОбъединитьПути(КаталогAppData, "1C", "1CEStart");
	ПутьКСпискуБаз = ОбъединитьПути(КаталогСпискаБаз, "ibases.v8i");
	СписокБаз = Новый СписокИнформационныхБаз();
	СписокБаз.ОбеспечитьЗаписьБазы(
		ПутьКСпискуБаз,
		ИмяКорневойПапки,
		ИмяWorktree,
		ПутьКБазе,
		ИмяБазы,
		ИмяБазыПередано
	);

КонецПроцедуры

#КонецОбласти
