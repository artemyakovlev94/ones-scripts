#Область ПрограммныйИнтерфейс

// Создаёт новую или обновляет существующую файловую базу worktree, подключает расширения и запускает клиент.
Процедура Запустить(ИмяWorktree, ПутьWorktree, ИмяБазы, ПутьКБазе, ПараметрыОкружения, Расширения, КореньПроекта) Экспорт

	ПодключитьЗависимости();
	ПроверитьПараметры(ИмяWorktree, ПутьWorktree, ПутьКБазе, ПараметрыОкружения, КореньПроекта);

	ИмяБазыПередано = Не ПустаяСтрока(ИмяБазы);
	Если ПустаяСтрока(ИмяБазы) Тогда
		ИмяБазы = ИмяWorktree;
	КонецЕсли;
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ПутьКБазе = ОбъединитьПути(ПараметрыОкружения.ONE_C_BASES_PATH, ИмяWorktree);
	КонецЕсли;
	ПроверитьЗаполнение(ИмяБазы, "Не удалось определить имя базы данных");
	ПроверитьЗаполнение(ПутьКБазе, "Не удалось определить путь к базе данных");
	ПутьККонфигурации = ОбъединитьПути(ПутьWorktree, ПараметрыОкружения.WORKTREE_PATH_CF);
	ПутьКТестовомуРасширению = ОбъединитьПути(ПутьWorktree, ПараметрыОкружения.WORKTREE_PATH_CFE_TEST);
	ПроверитьКаталог(ПутьККонфигурации, "исходников конфигурации");
	ПроверитьКаталог(ПутьКТестовомуРасширению, "исходников тестового расширения");
	ПроверитьФайлыРасширений(Расширения);

	БазаСуществует = КаталогСуществует(ПутьКБазе);
	БазаСоздана = Не БазаСуществует;
	Если БазаСоздана Тогда
		СоздатьБазу(ПутьКБазе, ПутьККонфигурации, ПараметрыОкружения.ONE_C_PLATFORM_VERSION, ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	КонецЕсли;
	ОбеспечитьЗаписьВСпискеБаз(
		ИмяWorktree,
		ИмяБазы,
		ПутьКБазе,
		ПараметрыОкружения.ONE_C_IBASES_FOLDER,
		ИмяБазыПередано
	);

	Авторизация = ПолучитьАвторизацию(БазаСуществует, ПараметрыОкружения);
	Если БазаСуществует Тогда
		ЗагрузитьКонфигурацию(
			ПутьКБазе,
			ПутьККонфигурации,
			ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
			ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
			Авторизация
		);
	КонецЕсли;

	ЗагрузитьТестовоеРасширение(
		ИмяWorktree,
		ПутьКБазе,
		ПутьКТестовомуРасширению,
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		Авторизация,
		КореньПроекта
	);
	ЗагрузитьПереданныеРасширения(
		ПутьКБазе,
		Расширения,
		ПараметрыОкружения.ONE_C_PLATFORM_VERSION,
		ПараметрыОкружения.ONE_C_PLATFORM_BITNESS,
		Авторизация
	);
	ЗапуститьКлиент(ПутьКБазе, ПараметрыОкружения.ONE_C_PLATFORM_VERSION, ПараметрыОкружения.ONE_C_PLATFORM_BITNESS, Авторизация);

КонецПроцедуры

Функция ПолучитьАвторизацию(БазаСуществует, ПараметрыОкружения)

	Авторизация = Новый Структура("Использовать,Пользователь,Пароль", Ложь, "", "");
	Если Не БазаСуществует Тогда
		Возврат Авторизация;
	КонецЕсли;

	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_INFOBASE_USER, "Не задана переменная ONE_C_INFOBASE_USER для существующей базы");
	Авторизация.Использовать = Истина;
	Авторизация.Пользователь = ПараметрыОкружения.ONE_C_INFOBASE_USER;
	Если ПараметрыОкружения.ONE_C_INFOBASE_PASSWORD <> Неопределено Тогда
		Авторизация.Пароль = ПараметрыОкружения.ONE_C_INFOBASE_PASSWORD;
	КонецЕсли;
	Возврат Авторизация;

КонецФункции

#КонецОбласти

#Область Подготовка

Процедура ПодключитьЗависимости()

	КаталогWorkflow = ТекущийСценарий().Каталог;
	КаталогБиблиотек = ОбъединитьПути(КаталогWorkflow, "..", "lib");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "process.os"), "ЗапускПроцессов");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "files.os"), "РаботаСФайлами");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "ibases.os"), "СписокИнформационныхБаз");

КонецПроцедуры

Процедура ПроверитьПараметры(ИмяWorktree, ПутьWorktree, ПутьКБазе, ПараметрыОкружения, КореньПроекта)

	ПроверитьЗаполнение(ИмяWorktree, "Не задан обязательный параметр --worktree-name");
	ПроверитьЗаполнение(ПутьWorktree, "Не задан обязательный параметр --worktree-path");
	ПроверитьЗаполнение(КореньПроекта, "Не задан корень проекта скриптов");
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_BASES_PATH, "Не задан параметр --db-path и переменная ONE_C_BASES_PATH");
	КонецЕсли;
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_PLATFORM_VERSION, "Не задана переменная ONE_C_PLATFORM_VERSION");
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS, "Не задана переменная ONE_C_PLATFORM_BITNESS");
	ПараметрыОкружения.ONE_C_PLATFORM_BITNESS = НРег(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьРазрядность(ПараметрыОкружения.ONE_C_PLATFORM_BITNESS);
	ПроверитьЗаполнение(ПараметрыОкружения.ONE_C_IBASES_FOLDER, "Не задана переменная ONE_C_IBASES_FOLDER");
	ПроверитьЗаполнение(ПараметрыОкружения.WORKTREE_PATH_CF, "Не задана переменная WORKTREE_PATH_CF");
	ПроверитьЗаполнение(ПараметрыОкружения.WORKTREE_PATH_CFE_TEST, "Не задана переменная WORKTREE_PATH_CFE_TEST");

КонецПроцедуры

Процедура ПроверитьРазрядность(Разрядность)

	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить("x64");
	ДопустимыеЗначения.Добавить("x86");
	ДопустимыеЗначения.Добавить("x64x86");
	ДопустимыеЗначения.Добавить("x86x64");
	Если ДопустимыеЗначения.Найти(НРег(Разрядность)) = Неопределено Тогда
		ВызватьИсключение "Недопустимое значение ONE_C_PLATFORM_BITNESS: " + Разрядность;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаполнение(Значение, ТекстОшибки)

	Если Значение = Неопределено Или ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКаталог(Путь, Описание)

	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Или Не Файл.ЭтоКаталог() Тогда
		ВызватьИсключение СтрШаблон("Не найден каталог %1: %2", Описание, Путь);
	КонецЕсли;

КонецПроцедуры

Функция КаталогСуществует(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();

КонецФункции

#КонецОбласти

#Область РаботаСБазой

Процедура СоздатьБазу(ПутьКБазе, ПутьККонфигурации, ВерсияПлатформы, Разрядность)

	Процессы = Новый ЗапускПроцессов();
	Команда = "vrunner init-dev"
		+ " --src " + Процессы.Аргумент(ПутьККонфигурации)
		+ " --ibcmd"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы);
	Процессы.ВыполнитьКоманду(Команда, "Создание информационной базы и загрузка конфигурации");

КонецПроцедуры

Процедура ЗагрузитьКонфигурацию(ПутьКБазе, ПутьККонфигурации, ВерсияПлатформы, Разрядность, Авторизация)

	Процессы = Новый ЗапускПроцессов();
	ПутьКIBCmd = ПолучитьПутьКIBCmd(ВерсияПлатформы, Разрядность);
	КомандаИмпорта = Процессы.Аргумент(ПутьКIBCmd)
		+ " infobase config import"
		+ " --db-path=" + Процессы.Аргумент(ПутьКБазе)
		+ " --user=" + Процессы.Аргумент(Авторизация.Пользователь)
		+ " --password=" + Процессы.Аргумент(Авторизация.Пароль)
		+ " " + Процессы.Аргумент(ПутьККонфигурации);
	Процессы.ВыполнитьКоманду(КомандаИмпорта, "Загрузка исходников конфигурации в существующую базу");

	КомандаОбновления = "vrunner updatedb"
		+ " --ibcmd"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы);
	КомандаОбновления = ДобавитьАвторизациюVanessa(КомандаОбновления, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(КомандаОбновления, "Обновление конфигурации базы данных");

КонецПроцедуры

Функция ПолучитьПутьКIBCmd(ВерсияПлатформы, Разрядность)

	КаталогиProgramFiles = Новый Массив;
	Если Разрядность = "x86" Или Разрядность = "x86x64" Тогда
		КаталогиProgramFiles.Добавить(ПолучитьПеременнуюСреды("ProgramFiles(x86)"));
		КаталогиProgramFiles.Добавить(ПолучитьПеременнуюСреды("ProgramFiles"));
	Иначе
		КаталогиProgramFiles.Добавить(ПолучитьПеременнуюСреды("ProgramFiles"));
		КаталогиProgramFiles.Добавить(ПолучитьПеременнуюСреды("ProgramFiles(x86)"));
	КонецЕсли;

	Для Каждого КаталогProgramFiles Из КаталогиProgramFiles Цикл
		Если ПустаяСтрока(КаталогProgramFiles) Тогда
			Продолжить;
		КонецЕсли;
		КаталогПлатформы = ОбъединитьПути(КаталогProgramFiles, "1cv8", ВерсияПлатформы);
		ПутьКIBCmd = ОбъединитьПути(КаталогПлатформы, "bin", "ibcmd.exe");
		ФайлIBCmd = Новый Файл(ПутьКIBCmd);
		Если ФайлIBCmd.Существует() Тогда
			Возврат ПутьКIBCmd;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден ibcmd.exe для версии платформы " + ВерсияПлатформы + " и разрядности " + Разрядность;

КонецФункции

#КонецОбласти

#Область РаботаСРасширениями

Процедура ЗагрузитьТестовоеРасширение(ИмяWorktree, ПутьКБазе, ПутьКИсходникам, ВерсияПлатформы, Разрядность, Авторизация, КореньПроекта)

	ИмяРасширения = ПрочитатьИмяРасширения(ПутьКИсходникам);
	ВременныйКаталог = ОбъединитьПути(КореньПроекта, ".temp");
	Файлы = Новый РаботаСФайлами();
	Файлы.ОбеспечитьКаталог(ВременныйКаталог);
	ПутьКCFE = ОбъединитьПути(ВременныйКаталог, ИмяWorktree + "-tests.cfe");

	Процессы = Новый ЗапускПроцессов();
	КомандаСборки = "vrunner compileexttocfe"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы)
		+ " --src " + Процессы.Аргумент(ПутьКИсходникам)
		+ " --out " + Процессы.Аргумент(ПутьКCFE);
	КомандаСборки = ДобавитьАвторизациюVanessa(КомандаСборки, Процессы, Авторизация);

	Попытка
		Процессы.ВыполнитьКоманду(КомандаСборки, "Сборка тестового расширения " + ИмяРасширения);
		ЗагрузитьРасширение(ПутьКБазе, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация);
		ОтключитьОграниченияРасширения(ПутьКБазе, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, Истина);
	Исключение
		УдалитьВременныйCFE(ПутьКCFE);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьВременныйCFE(ПутьКCFE);

КонецПроцедуры

Процедура ЗагрузитьПереданныеРасширения(ПутьКБазе, Расширения, ВерсияПлатформы, Разрядность, Авторизация)

	Для Каждого Расширение Из Расширения Цикл
		ЗагрузитьРасширение(ПутьКБазе, Расширение.path, Расширение.name, ВерсияПлатформы, Разрядность, Авторизация);
		ОтключитьОграниченияРасширения(ПутьКБазе, Расширение.name, ВерсияПлатформы, Разрядность, Авторизация, Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ОтключитьОграниченияРасширения(ПутьКБазе, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, ЭтоТестовоеРасширение)

	Процессы = Новый ЗапускПроцессов();
	ПутьКIBCmd = ПолучитьПутьКIBCmd(ВерсияПлатформы, Разрядность);
	Команда = Процессы.Аргумент(ПутьКIBCmd)
		+ " infobase config extension update"
		+ " --db-path=" + Процессы.Аргумент(ПутьКБазе)
		+ " --name=" + Процессы.Аргумент(ИмяРасширения)
		+ " --safe-mode=no"
		+ " --unsafe-action-protection=no";
	Если ЭтоТестовоеРасширение Тогда
		Команда = Команда + " --used-in-distributed-infobase=no";
	КонецЕсли;
	Команда = ДобавитьАвторизациюIBCmd(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Отключение ограничений расширения " + ИмяРасширения);

КонецПроцедуры

Процедура ЗагрузитьРасширение(ПутьКБазе, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация)

	Процессы = Новый ЗапускПроцессов();
	Команда = "vrunner loadext"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --updatedb"
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы)
		+ " --file " + Процессы.Аргумент(ПутьКCFE)
		+ " --extension " + Процессы.Аргумент(ИмяРасширения);
	Команда = ДобавитьАвторизациюVanessa(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Загрузка расширения " + ИмяРасширения);

КонецПроцедуры

Процедура УдалитьВременныйCFE(ПутьКCFE)

	ФайлCFE = Новый Файл(ПутьКCFE);
	Если ФайлCFE.Существует() Тогда
		УдалитьФайлы(ПутьКCFE);
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьИмяРасширения(ПутьКИсходникам)

	ПутьКConfigurationXML = ОбъединитьПути(ПутьКИсходникам, "Configuration.xml");
	ФайлConfigurationXML = Новый Файл(ПутьКConfigurationXML);
	Если Не ФайлConfigurationXML.Существует() Тогда
		ВызватьИсключение "Не найден Configuration.xml тестового расширения: " + ПутьКConfigurationXML;
	КонецЕсли;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКConfigurationXML);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "Name" Тогда
			Если Чтение.Прочитать() И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				ИмяРасширения = Чтение.Значение;
				Чтение.Закрыть();
				Возврат ИмяРасширения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	ВызватьИсключение "В Configuration.xml не найдено имя тестового расширения: " + ПутьКConfigurationXML;

КонецФункции

Процедура ПроверитьФайлыРасширений(Расширения)

	Для Каждого Расширение Из Расширения Цикл
		ПроверитьЗаполнение(Расширение.name, "Не заполнен параметр --extension-name");
		ПроверитьЗаполнение(Расширение.path, "Не заполнен параметр --extension-path");
		ФайлРасширения = Новый Файл(Расширение.path);
		Если Не ФайлРасширения.Существует() Или ФайлРасширения.ЭтоКаталог() Тогда
			ВызватьИсключение СтрШаблон("Не найден файл расширения %1: %2", Расширение.name, Расширение.path);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РегистрацияИЗапуск

Процедура ОбеспечитьЗаписьВСпискеБаз(ИмяWorktree, ИмяБазы, ПутьКБазе, ИмяКорневойПапки, ИмяБазыПередано)

	КаталогAppData = ПолучитьПеременнуюСреды("APPDATA");
	ПроверитьЗаполнение(КаталогAppData, "Не определена системная переменная APPDATA");
	КаталогСпискаБаз = ОбъединитьПути(КаталогAppData, "1C", "1CEStart");
	ПутьКСпискуБаз = ОбъединитьПути(КаталогСпискаБаз, "ibases.v8i");
	СписокБаз = Новый СписокИнформационныхБаз();
	СписокБаз.ОбеспечитьЗаписьБазы(
		ПутьКСпискуБаз,
		ИмяКорневойПапки,
		ИмяWorktree,
		ПутьКБазе,
		ИмяБазы,
		ИмяБазыПередано
	);

КонецПроцедуры

Процедура ЗапуститьКлиент(ПутьКБазе, ВерсияПлатформы, Разрядность, Авторизация)

	Процессы = Новый ЗапускПроцессов();
	Команда = "vrunner run"
		+ " --bitness=" + Разрядность
		+ " --no-wait"
		+ " --nocacheuse"
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы)
		+ " --additional=" + Процессы.Аргумент("/itdi");
	Команда = ДобавитьАвторизациюVanessa(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Запуск клиента 1С:Предприятия");

КонецПроцедуры

Функция ДобавитьАвторизациюVanessa(Команда, Процессы, Авторизация)

	Если Не Авторизация.Использовать Тогда
		Возврат Команда;
	КонецЕсли;

	Возврат Команда
		+ " --db-user " + Процессы.Аргумент(Авторизация.Пользователь)
		+ " --db-pwd " + Процессы.Аргумент(Авторизация.Пароль);

КонецФункции

Функция ДобавитьАвторизациюIBCmd(Команда, Процессы, Авторизация)

	Если Не Авторизация.Использовать Тогда
		Возврат Команда;
	КонецЕсли;

	Возврат Команда
		+ " --user=" + Процессы.Аргумент(Авторизация.Пользователь)
		+ " --password=" + Процессы.Аргумент(Авторизация.Пароль);

КонецФункции

#КонецОбласти
