#Область ПрограммныйИнтерфейс

// Скачивает ZIP-архив, находит в нём единственный файл CFE BSP и помещает его в каталог назначения.
Процедура Запустить(АдресАрхива, КаталогНазначения, ИмяФайлаНазначения) Экспорт

	ПодключитьЗависимости();
	ПроверитьПараметры(АдресАрхива, КаталогНазначения, ИмяФайлаНазначения);

	ПутьКАрхиву = ПолучитьИмяВременногоФайла("zip");
	КаталогРаспаковки = ПолучитьИмяВременногоФайла();

	Попытка
		СкачатьИРаспаковать(АдресАрхива, ПутьКАрхиву, КаталогРаспаковки);
		СохранитьCFE(КаталогРаспаковки, КаталогНазначения, ИмяФайлаНазначения);
	Исключение
		ОчиститьВременныеФайлы(ПутьКАрхиву, КаталогРаспаковки);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременныеФайлы(ПутьКАрхиву, КаталогРаспаковки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодключитьЗависимости()

	КаталогWorkflow = ТекущийСценарий().Каталог;
	КаталогБиблиотек = ОбъединитьПути(КаталогWorkflow, "..", "lib");

	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "download.os"), "ЗагрузкаФайлов");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "archive.os"), "РаботаСАрхивами");
	ПодключитьСценарий(ОбъединитьПути(КаталогБиблиотек, "files.os"), "РаботаСФайлами");

КонецПроцедуры

Процедура ПроверитьПараметры(АдресАрхива, КаталогНазначения, ИмяФайлаНазначения)

	ПроверитьЗаполнение(АдресАрхива, "Не задан адрес архива");
	ПроверитьЗаполнение(КаталогНазначения, "Не задан каталог назначения");
	ПроверитьЗаполнение(ИмяФайлаНазначения, "Не задано конечное имя файла");

	Если НРег(Прав(ИмяФайлаНазначения, 4)) <> ".cfe" Тогда
		ВызватьИсключение "Конечное имя файла должно иметь расширение .cfe";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаполнение(Значение, ТекстОшибки)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Процедура СкачатьИРаспаковать(АдресАрхива, ПутьКАрхиву, КаталогРаспаковки)

	Загрузка = Новый ЗагрузкаФайлов();
	Архивы = Новый РаботаСАрхивами();

	Загрузка.Скачать(АдресАрхива, ПутьКАрхиву);
	СоздатьКаталог(КаталогРаспаковки);
	Архивы.РаспаковатьZIP(ПутьКАрхиву, КаталогРаспаковки);

КонецПроцедуры

Процедура СохранитьCFE(КаталогРаспаковки, КаталогНазначения, ИмяФайлаНазначения)

	Файлы = Новый РаботаСФайлами();
	ПутьКCFE = Файлы.НайтиЕдинственныйФайл(КаталогРаспаковки, "*.cfe");
	Файлы.СкопироватьСКонечнымИменем(ПутьКCFE, КаталогНазначения, ИмяФайлаНазначения);

КонецПроцедуры

Процедура ОчиститьВременныеФайлы(ПутьКАрхиву, КаталогРаспаковки)

	УдалитьФайлы(ПутьКАрхиву);
	УдалитьФайлы(КаталогРаспаковки, "*");
	УдалитьФайлы(КаталогРаспаковки);

КонецПроцедуры

#КонецОбласти
