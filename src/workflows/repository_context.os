#Область ПрограммныйИнтерфейс

Функция Получить(ПутьРепозитория, ИмяВетки) Экспорт

	ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "lib", "git.os"), "ОперацииGit");
	Git = Новый ОперацииGit();
	Если ПустаяСтрока(ПутьРепозитория) Тогда
		ПутьРепозитория = ТекущийКаталог();
	КонецЕсли;
	ПутьРепозитория = Git.ПолучитьКореньРепозитория(ПутьРепозитория);
	Если ПустаяСтрока(ИмяВетки) Тогда
		ИмяВетки = Git.ПолучитьТекущуюВетку(ПутьРепозитория);
	КонецЕсли;
	ПроверитьИмяВетки(ИмяВетки);
	ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "lib", "logger.os"), "Логирование");
	Лог = Новый Логирование();
	Лог.Вывести("Репозиторий: " + ПутьРепозитория + ". Имя задачи: " + ИмяВетки);
	Возврат Новый Структура("ПутьРепозитория, ИмяВетки", ПутьРепозитория, ИмяВетки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИмяВетки(ИмяВетки)

	Если ПустаяСтрока(ИмяВетки) Или ИмяВетки = "." Или ИмяВетки = ".." Тогда
		ВызватьИсключение "Не задано допустимое имя ветки. Передайте --branch-name.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(ИмяВетки) Цикл
		Символ = Сред(ИмяВетки, Индекс, 1);
		Если Найти("/\:*?""<>|", Символ) > 0 Или КодСимвола(Символ) < 32 Тогда
			ВызватьИсключение "Имя ветки нельзя использовать как имя каталога базы. Передайте --branch-name с коротким именем задачи без специальных символов.";
		КонецЕсли;
	КонецЦикла;
	Если Прав(ИмяВетки, 1) = "." Или Прав(ИмяВетки, 1) = " " Тогда
		ВызватьИсключение "Имя ветки не должно оканчиваться точкой или пробелом. Передайте --branch-name.";
	КонецЕсли;
	ОсноваИмени = ВРег(СтрРазделить(ИмяВетки, ".")[0]);
	Если ОсноваИмени = "CON" Или ОсноваИмени = "PRN" Или ОсноваИмени = "AUX" Или ОсноваИмени = "NUL"
		Или (СтрДлина(ОсноваИмени) = 4 И (Лев(ОсноваИмени, 3) = "COM" Или Лев(ОсноваИмени, 3) = "LPT")
			И Найти("123456789", Прав(ОсноваИмени, 1)) > 0) Тогда
		ВызватьИсключение "Имя ветки зарезервировано Windows. Передайте --branch-name.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
