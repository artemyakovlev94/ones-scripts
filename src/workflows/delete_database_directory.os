#Область ПрограммныйИнтерфейс

Процедура Запустить(ПутьКБазе, ИмяПапкиСпискаБаз) Экспорт

	Если ПутьКБазе = Неопределено Или ПустаяСтрока(Строка(ПутьКБазе)) Тогда
		ВызватьИсключение "Не задан обязательный параметр --db-path";
	КонецЕсли;

	КаталогБазы = Новый Файл(ПутьКБазе);
	Если Не КаталогБазы.Существует() Тогда
		ВызватьИсключение "Каталог базы данных не найден: " + ПутьКБазе;
	КонецЕсли;
	Если Не КаталогБазы.ЭтоКаталог() Тогда
		ВызватьИсключение "Параметр --db-path должен указывать каталог базы данных: " + ПутьКБазе;
	КонецЕсли;
	Если ПустаяСтрока(КаталогБазы.Имя) Тогда
		ВызватьИсключение "Корень файловой системы нельзя удалить как каталог базы данных: " + ПутьКБазе;
	КонецЕсли;
	Если ИмяПапкиСпискаБаз = Неопределено Или ПустаяСтрока(Строка(ИмяПапкиСпискаБаз)) Тогда
		ВызватьИсключение "Не задана переменная ONE_C_IBASES_FOLDER";
	КонецЕсли;

	ПутьКФайлуБазы = ОбъединитьПути(ПутьКБазе, "1Cv8.1CD");
	ФайлБазы = Новый Файл(ПутьКФайлуБазы);
	Если Не ФайлБазы.Существует() Или ФайлБазы.ЭтоКаталог() Тогда
		ВызватьИсключение "В удаляемом каталоге не найден файл 1Cv8.1CD: " + ПутьКБазе;
	КонецЕсли;

	Лог = Новый Логирование();
	УдалитьОписаниеИзСпискаБаз(КаталогБазы.ПолноеИмя, ИмяПапкиСпискаБаз, Лог);
	Лог.Вывести("Удаление каталога базы данных: " + КаталогБазы.ПолноеИмя);
	Файлы = Новый РаботаСФайлами();
	Файлы.УдалитьКаталогРекурсивно(КаталогБазы.ПолноеИмя);
	Лог.Вывести("Каталог базы данных удалён");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьОписаниеИзСпискаБаз(ПутьКБазе, ИмяПапкиСпискаБаз, Лог)

	КаталогAppData = ПолучитьПеременнуюСреды("APPDATA");
	Если КаталогAppData = Неопределено Или ПустаяСтрока(Строка(КаталогAppData)) Тогда
		ВызватьИсключение "Не определена системная переменная APPDATA";
	КонецЕсли;
	ПутьКСпискуБаз = ОбъединитьПути(КаталогAppData, "1C", "1CEStart", "ibases.v8i");
	Лог.Вывести("Удаление описания базы из папки " + ИмяПапкиСпискаБаз + " в ibases.v8i");
	СписокБаз = Новый СписокИнформационныхБаз();
	СписокБаз.УдалитьЗаписиБазыПоПутиВПапке(
		ПутьКСпискуБаз,
		ИмяПапкиСпискаБаз,
		ПутьКБазе
	);

КонецПроцедуры

#КонецОбласти
