#Область ПрограммныйИнтерфейс

Процедура Запустить(ПутьКБазе, ПутьКШаблону) Экспорт

	ПроверитьЗаполнение(ПутьКБазе, "Не задан обязательный параметр --db-path");
	ПроверитьЗаполнение(ПутьКШаблону, "Не задана переменная ONE_C_BASES_TEMPLATE");

	ПутьКИсходномуФайлу = ОбъединитьПути(ПутьКБазе, "1Cv8.1CD");
	ИсходныйФайл = Новый Файл(ПутьКИсходномуФайлу);
	Если Не ИсходныйФайл.Существует() Или ИсходныйФайл.ЭтоКаталог() Тогда
		ВызватьИсключение "В исходной базе не найден файл 1Cv8.1CD: " + ПутьКБазе;
	КонецЕсли;

	ПутьКЦелевомуФайлу = ОбъединитьПути(ПутьКШаблону, "1Cv8.1CD");
	ЦелевойФайл = Новый Файл(ПутьКЦелевомуФайлу);
	Если ИсходныйФайл.ПолноеИмя = ЦелевойФайл.ПолноеИмя Тогда
		ВызватьИсключение "Исходная база уже находится в каталоге ONE_C_BASES_TEMPLATE: " + ПутьКШаблону;
	КонецЕсли;

	Лог = Новый Логирование();
	СоздатьРезервнуюКопиюШаблона(ПутьКШаблону, ЦелевойФайл, Лог);
	Лог.Вывести("Копирование файла базы в каталог шаблона");
	Файлы = Новый РаботаСФайлами();
	Файлы.СкопироватьСКонечнымИменем(ПутьКИсходномуФайлу, ПутьКШаблону, "1Cv8.1CD");
	Лог.Вывести("Шаблон базы обновлён: " + ПутьКЦелевомуФайлу);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьРезервнуюКопиюШаблона(ПутьКШаблону, ФайлШаблона, Лог)

	Если Не ФайлШаблона.Существует() Или ФайлШаблона.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;

	Файлы = Новый РаботаСФайлами();
	ПутьКПервойКопии = ОбъединитьПути(ПутьКШаблону, "1Cv8_1.1CD.bak");
	ПерваяКопия = Новый Файл(ПутьКПервойКопии);
	Если ПерваяКопия.Существует() И Не ПерваяКопия.ЭтоКаталог() Тогда
		Лог.Вывести("Сохранение предыдущей резервной копии: 1Cv8_2.1CD.bak");
		Файлы.СкопироватьСКонечнымИменем(
			ПутьКПервойКопии,
			ПутьКШаблону,
			"1Cv8_2.1CD.bak"
		);
	КонецЕсли;

	Лог.Вывести("Создание резервной копии шаблона: 1Cv8_1.1CD.bak");
	Файлы.СкопироватьСКонечнымИменем(
		ФайлШаблона.ПолноеИмя,
		ПутьКШаблону,
		"1Cv8_1.1CD.bak"
	);

КонецПроцедуры

Процедура ПроверитьЗаполнение(Значение, ТекстОшибки)

	Если Значение = Неопределено Или ПустаяСтрока(Строка(Значение)) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
