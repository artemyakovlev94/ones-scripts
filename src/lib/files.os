#Область ПрограммныйИнтерфейс

// Возвращает единственный файл, соответствующий маске, из каталога и его подкаталогов.
Функция НайтиЕдинственныйФайл(Каталог, Маска) Экспорт

	НайденныеФайлы = НайтиФайлы(Каталог, Маска, Истина);
	Если НайденныеФайлы.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге не найден файл по маске " + Маска + ": " + Каталог;
	КонецЕсли;

	Если НайденныеФайлы.Количество() > 1 Тогда
		ВызватьИсключение "В каталоге найдено несколько файлов по маске " + Маска + ": " + Каталог;
	КонецЕсли;

	Возврат НайденныеФайлы[0].ПолноеИмя;

КонецФункции

// Создаёт каталог, если он ещё не существует.
Процедура ОбеспечитьКаталог(ПутьКаталога) Экспорт

	Каталог = Новый Файл(ПутьКаталога);
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(ПутьКаталога);
	КонецЕсли;

КонецПроцедуры

// Копирует файл в каталог назначения под заданным именем.
Процедура СкопироватьСКонечнымИменем(ИсходныйФайл, КаталогНазначения, ИмяФайла) Экспорт

	ОбеспечитьКаталог(КаталогНазначения);
	ПутьНазначения = ОбъединитьПути(КаталогНазначения, ИмяФайла);
	КопироватьФайл(ИсходныйФайл, ПутьНазначения);

КонецПроцедуры

#КонецОбласти
