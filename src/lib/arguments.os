#Область ПрограммныйИнтерфейс

// Разбирает именованные параметры, переданные парами в произвольном порядке.
Функция ПрочитатьИменованныеПараметры(Аргументы, ДопустимыеИмена, ПовторяемыеИмена = Неопределено) Экспорт

	Если Аргументы.Количество() % 2 <> 0 Тогда
		ВызватьИсключение "Именованные параметры должны передаваться парами в формате --имя значение";
	КонецЕсли;

	ДопустимыеИменаПоКлючу = Новый Соответствие;
	Для Каждого ДопустимоеИмя Из ДопустимыеИмена Цикл
		ДопустимыеИменаПоКлючу.Вставить(ДопустимоеИмя, Истина);
	КонецЦикла;
	ПовторяемыеИменаПоКлючу = Новый Соответствие;
	Если ПовторяемыеИмена <> Неопределено Тогда
		Для Каждого ПовторяемоеИмя Из ПовторяемыеИмена Цикл
			Если ДопустимыеИменаПоКлючу.Получить(ПовторяемоеИмя) = Неопределено Тогда
				ВызватьИсключение "Повторяемый параметр отсутствует среди допустимых: " + ПовторяемоеИмя;
			КонецЕсли;
			ПовторяемыеИменаПоКлючу.Вставить(ПовторяемоеИмя, Истина);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Соответствие;
	Индекс = 0;
	Пока Индекс < Аргументы.Количество() Цикл
		ИмяПараметра = Аргументы[Индекс];
		Если ДопустимыеИменаПоКлючу.Получить(ИмяПараметра) = Неопределено Тогда
			ВызватьИсключение "Неизвестный параметр: " + ИмяПараметра;
		КонецЕсли;

		КлючПараметра = Сред(ИмяПараметра, 3);
		Если ПовторяемыеИменаПоКлючу.Получить(ИмяПараметра) <> Неопределено Тогда
			ЗначенияПараметра = Результат.Получить(КлючПараметра);
			Если ЗначенияПараметра = Неопределено Тогда
				ЗначенияПараметра = Новый Массив;
				Результат.Вставить(КлючПараметра, ЗначенияПараметра);
			КонецЕсли;
			ЗначенияПараметра.Добавить(Аргументы[Индекс + 1]);
		ИначеЕсли Результат.Получить(КлючПараметра) <> Неопределено Тогда
			ВызватьИсключение "Параметр передан повторно: " + ИмяПараметра;
		Иначе
			Результат.Вставить(КлючПараметра, Аргументы[Индекс + 1]);
		КонецЕсли;
		Индекс = Индекс + 2;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
