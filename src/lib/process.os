#Область ПрограммныйИнтерфейс

// Выполняет команду, ожидает её завершения и вызывает исключение при ненулевом коде возврата.
Процедура ВыполнитьКоманду(Команда, ОписаниеЭтапа) Экспорт

	Сообщить(ОписаниеЭтапа);
	КодВозврата = Неопределено;
	ЗапуститьПриложение(Команда, , Истина, КодВозврата);

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Этап завершился с ошибкой: %1. Код возврата: %2", ОписаниеЭтапа, КодВозврата);
	КонецЕсли;

КонецПроцедуры

// Возвращает значение, заключённое в двойные кавычки для передачи командной строке.
Функция Аргумент(Значение) Экспорт

	Возврат """" + СтрЗаменить(Строка(Значение), """", """""") + """";

КонецФункции

#КонецОбласти
