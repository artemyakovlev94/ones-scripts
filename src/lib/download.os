#Область ПрограммныйИнтерфейс

// Скачивает ресурс по URL в указанный файл.
Процедура Скачать(АдресURL, ПутьНазначения) Экспорт

	ПараметрыАдреса = РазобратьАдрес(АдресURL);
	Соединение = Новый HTTPСоединение(ПараметрыАдреса.АдресСервера);
	Соединение.РазрешитьАвтоматическоеПеренаправление = Истина;
	Ответ = Соединение.Получить(Новый HTTPЗапрос(ПараметрыАдреса.ПутьЗапроса), ПутьНазначения);

	ПроверитьОтвет(Ответ, ПутьНазначения);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьАдрес(АдресURL)

	ПозицияСхемы = Найти(АдресURL, "://");
	Если ПозицияСхемы = 0 Тогда
		ВызватьИсключение "Некорректный URL: " + АдресURL;
	КонецЕсли;

	НачалоПутиВСервере = Найти(Сред(АдресURL, ПозицияСхемы + 3), "/");
	Если НачалоПутиВСервере = 0 Тогда
		ВызватьИсключение "В URL не указан путь к ресурсу: " + АдресURL;
	КонецЕсли;

	НачалоПути = ПозицияСхемы + НачалоПутиВСервере + 2;
	АдресСервера = Лев(АдресURL, НачалоПути - 1);
	ПутьЗапроса = УдалитьФрагмент(Сред(АдресURL, НачалоПути));

	Возврат Новый Структура("АдресСервера, ПутьЗапроса", АдресСервера, ПутьЗапроса);

КонецФункции

Функция УдалитьФрагмент(ПутьЗапроса)

	ПозицияФрагмента = Найти(ПутьЗапроса, "#");
	Если ПозицияФрагмента = 0 Тогда
		Возврат ПутьЗапроса;
	КонецЕсли;

	Возврат Лев(ПутьЗапроса, ПозицияФрагмента - 1);

КонецФункции

Процедура ПроверитьОтвет(Ответ, ПутьНазначения)

	КодСостояния = Ответ.КодСостояния;
	Ответ.Закрыть();

	Если КодСостояния >= 200 И КодСостояния < 300 Тогда
		Возврат;
	КонецЕсли;

	УдалитьФайлы(ПутьНазначения);
	ВызватьИсключение "Не удалось скачать файл. Код HTTP: " + КодСостояния;

КонецПроцедуры

#КонецОбласти
