#Область ПрограммныйИнтерфейс

Функция ПолучитьКореньРепозитория(Каталог) Экспорт

	Возврат ВыполнитьGit(Каталог, "rev-parse --show-toplevel");

КонецФункции

Функция ПолучитьТекущуюВетку(Каталог) Экспорт

	Возврат ВыполнитьGit(Каталог, "symbolic-ref --quiet --short HEAD");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьGit(Каталог, Аргументы)

	Процесс = СоздатьПроцесс("git " + Аргументы, Каталог, Истина, Ложь, "utf-8");
	Процесс.Запустить();
	Результат = "";
	ТекстОшибки = "";
	Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Или Процесс.ПотокОшибок.ЕстьДанные Цикл
		Результат = Результат + Процесс.ПотокВывода.Прочитать();
		ТекстОшибки = ТекстОшибки + Процесс.ПотокОшибок.Прочитать();
		Приостановить(10);
	КонецЦикла;
	Процесс.ОжидатьЗавершения();
	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить репозиторий или текущую ветку Git. Проверьте каталог, установку Git и состояние HEAD либо передайте --branch-name. " + ТекстОшибки;
	КонецЕсли;
	Возврат СокрЛП(Результат);

КонецФункции

#КонецОбласти
