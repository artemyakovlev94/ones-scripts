#Область ПрограммныйИнтерфейс

// Извлекает всё содержимое ZIP-архива в указанный каталог.
Процедура РаспаковатьZIP(ПутьКАрхиву, КаталогНазначения) Экспорт

	ЧтениеАрхива = Новый ЧтениеZIPФайла;
	ЧтениеАрхива.Открыть(ПутьКАрхиву);

	Попытка
		ЧтениеАрхива.ИзвлечьВсе(КаталогНазначения, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	Исключение
		ЧтениеАрхива.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ЧтениеАрхива.Закрыть();

КонецПроцедуры

#КонецОбласти
