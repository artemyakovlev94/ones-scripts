#Область ПрограммныйИнтерфейс

Процедура СобратьВCFE(ПутьКБазе, ПутьКИсходникам, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация) Экспорт

	Процессы = Новый ЗапускПроцессов();
	ОперацииБазы = Новый ОперацииСБазой1С();
	Команда = "vrunner compileexttocfe"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы)
		+ " --src " + Процессы.Аргумент(ПутьКИсходникам)
		+ " --out " + Процессы.Аргумент(ПутьКCFE);
	Команда = ОперацииБазы.ДобавитьАвторизациюVanessa(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Сборка тестового расширения " + ИмяРасширения);

КонецПроцедуры

Процедура ЗагрузитьИзCFE(ПутьКБазе, ПутьКCFE, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация) Экспорт

	Процессы = Новый ЗапускПроцессов();
	ОперацииБазы = Новый ОперацииСБазой1С();
	Команда = "vrunner loadext"
		+ " --nocacheuse"
		+ " --bitness=" + Разрядность
		+ " --updatedb"
		+ " --ibconnection " + Процессы.Аргумент("/F" + ПутьКБазе)
		+ " --v8version " + Процессы.Аргумент(ВерсияПлатформы)
		+ " --file " + Процессы.Аргумент(ПутьКCFE)
		+ " --extension " + Процессы.Аргумент(ИмяРасширения);
	Команда = ОперацииБазы.ДобавитьАвторизациюVanessa(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Загрузка расширения " + ИмяРасширения);

КонецПроцедуры

Процедура ОтключитьОграничения(ПутьКБазе, ИмяРасширения, ВерсияПлатформы, Разрядность, Авторизация, ЭтоТестовоеРасширение) Экспорт

	Процессы = Новый ЗапускПроцессов();
	ОперацииБазы = Новый ОперацииСБазой1С();
	ПутьКIBCmd = ОперацииБазы.ПолучитьПутьКIBCmd(ВерсияПлатформы, Разрядность);
	Команда = Процессы.Аргумент(ПутьКIBCmd)
		+ " infobase config extension update"
		+ " --db-path=" + Процессы.Аргумент(ПутьКБазе)
		+ " --name=" + Процессы.Аргумент(ИмяРасширения)
		+ " --safe-mode=no"
		+ " --unsafe-action-protection=no";
	Если ЭтоТестовоеРасширение Тогда
		Команда = Команда + " --used-in-distributed-infobase=no";
	КонецЕсли;
	Команда = ОперацииБазы.ДобавитьАвторизациюIBCmd(Команда, Процессы, Авторизация);
	Процессы.ВыполнитьКоманду(Команда, "Отключение ограничений расширения " + ИмяРасширения);

КонецПроцедуры

Функция ПрочитатьИмяИзИсходников(ПутьКИсходникам) Экспорт

	ПутьКConfigurationXML = ОбъединитьПути(ПутьКИсходникам, "Configuration.xml");
	ФайлConfigurationXML = Новый Файл(ПутьКConfigurationXML);
	Если Не ФайлConfigurationXML.Существует() Тогда
		ВызватьИсключение "Не найден Configuration.xml тестового расширения: " + ПутьКConfigurationXML;
	КонецЕсли;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКConfigurationXML);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "Name" Тогда
			Если Чтение.Прочитать() И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				ИмяРасширения = Чтение.Значение;
				Чтение.Закрыть();
				Возврат ИмяРасширения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	ВызватьИсключение "В Configuration.xml не найдено имя тестового расширения: " + ПутьКConfigurationXML;

КонецФункции

Процедура УдалитьCFE(ПутьКCFE) Экспорт

	ФайлCFE = Новый Файл(ПутьКCFE);
	Если ФайлCFE.Существует() Тогда
		УдалитьФайлы(ПутьКCFE);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
