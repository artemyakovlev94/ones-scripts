#Область ПрограммныйИнтерфейс

Функция ПолучитьПризнак(ЗначениеНастройки) Экспорт

	Если ЗначениеНастройки = Неопределено Или ПустаяСтрока(ЗначениеНастройки) Тогда
		Возврат Ложь;
	КонецЕсли;
	НормализованноеЗначение = НРег(СокрЛП(Строка(ЗначениеНастройки)));
	Если НормализованноеЗначение = "true" Или НормализованноеЗначение = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если НормализованноеЗначение = "false" Или НормализованноеЗначение = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	ВызватьИсключение "Недопустимое значение PLAY_COMPLETION_SOUND: "
		+ Строка(ЗначениеНастройки) + ". Допустимы true, false, 1 или 0";

КонецФункции

Процедура Воспроизвести(ВоспроизводитьЗвук, ЭтоОшибка = Ложь) Экспорт

	Если Не ВоспроизводитьЗвук Тогда
		Возврат;
	КонецЕсли;

	ИмяЗвука = ?(ЭтоОшибка, "Hand", "Asterisk");
	СценарийPowerShell = "Add-Type -AssemblyName System.Windows.Forms;"
		+ "[System.Media.SystemSounds]::" + ИмяЗвука + ".Play();"
		+ "Start-Sleep -Milliseconds 700;";

	Процессы = Новый ЗапускПроцессов();
	Команда = "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "
		+ Процессы.Аргумент(СценарийPowerShell);
	Попытка
		Процессы.ВыполнитьКоманду(Команда, "Завершение", Ложь);
	Исключение
		Лог = Новый Логирование();
		Лог.Вывести("Не удалось воспроизвести звук завершения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
