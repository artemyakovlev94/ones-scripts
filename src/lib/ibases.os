#Область ПрограммныйИнтерфейс

// Обеспечивает папки и запись файловой базы в списке информационных баз пользователя.
Процедура ОбеспечитьЗаписьБазы(
	ПутьКФайлу,
	ИмяКорневойПапки,
	ИмяWorktree,
	ПутьКБазе,
	ИмяБазы = "",
	НеИзменятьЕслиИмяБазыНайдено = Ложь
) Экспорт

	ПроверитьПараметры(ИмяКорневойПапки, ИмяWorktree, ПутьКБазе);
	Если ПустаяСтрока(ИмяБазы) Тогда
		ИмяБазы = ИмяWorktree;
	КонецЕсли;
	Секции = ПрочитатьСекции(ПутьКФайлу);
	ПроверитьУникальность(Секции);
	Если НеИзменятьЕслиИмяБазыНайдено
		И НайтиСекцию(Секции, ИмяБазы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	КорневаяПапка = НайтиСекцию(Секции, ИмяКорневойПапки);
	Если КорневаяПапка = Неопределено Тогда
		КорневаяПапка = СоздатьПапку(Секции, ИмяКорневойПапки, "/");
	Иначе
		ПроверитьЧтоСекцияПапка(КорневаяПапка);
	КонецЕсли;

	ИмяПапкиWorktree = "_" + ИмяWorktree;
	ПутьКорневойПапки = "/" + ИмяКорневойПапки;
	ПапкаWorktree = НайтиПапкуВПапкеПоБазовомуИмени(Секции, ПутьКорневойПапки, ИмяПапкиWorktree);
	Если ПапкаWorktree = Неопределено Тогда
		УникальноеИмяПапки = ПолучитьУникальноеИмяСекции(Секции, ИмяПапкиWorktree);
		ПапкаWorktree = СоздатьПапку(Секции, УникальноеИмяПапки, ПутьКорневойПапки);
	КонецЕсли;

	ПутьПапкиWorktree = ПутьКорневойПапки + "/" + ПапкаWorktree.Имя;
	Если НайтиБазуВПапкеПоБазовомуИмени(Секции, ПутьПапкиWorktree, ИмяБазы) = Неопределено Тогда
		УникальноеИмяБазы = ПолучитьУникальноеИмяСекции(Секции, ИмяБазы);
		СоздатьБазу(Секции, УникальноеИмяБазы, ПутьКБазе, ПутьПапкиWorktree);
	КонецЕсли;

	ПроверитьУникальность(Секции);
	ЗаписатьСекции(ПутьКФайлу, Секции);

КонецПроцедуры

// Обеспечивает отдельную запись переданной базы непосредственно в указанной корневой папке.
Процедура ОбеспечитьЗаписьБазыПоПути(ПутьКФайлу, ИмяКорневойПапки, ИмяБазы, ПутьКБазе) Экспорт

	ПроверитьПараметры(ИмяКорневойПапки, ИмяБазы, ПутьКБазе);
	Секции = ПрочитатьСекции(ПутьКФайлу);
	ПроверитьУникальность(Секции);
	ПутьКорневойПапки = "/" + ИмяКорневойПапки;
	СекцияСИсходнымИменем = НайтиСекцию(Секции, ИмяБазы);

	Если СекцияСИсходнымИменем <> Неопределено
		И НайтиБазуВПапкеПоБазовомуИмени(Секции, ПутьКорневойПапки, ИмяБазы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	КорневаяПапка = НайтиСекцию(Секции, ИмяКорневойПапки);
	Если КорневаяПапка = Неопределено Тогда
		КорневаяПапка = СоздатьПапку(Секции, ИмяКорневойПапки, "/");
	Иначе
		ПроверитьЧтоСекцияПапка(КорневаяПапка);
	КонецЕсли;

	Если СекцияСИсходнымИменем = Неопределено Тогда
		УникальноеИмяБазы = ИмяБазы;
	Иначе
		УникальноеИмяБазы = ПолучитьУникальноеИмяСекции(Секции, ИмяБазы);
	КонецЕсли;
	СоздатьБазу(Секции, УникальноеИмяБазы, ПутьКБазе, ПутьКорневойПапки);

	ПроверитьУникальность(Секции);
	ЗаписатьСекции(ПутьКФайлу, Секции);

КонецПроцедуры

// Удаляет описания базы по пути только из указанной корневой папки и её подпапок.
Процедура УдалитьЗаписиБазыПоПутиВПапке(ПутьКФайлу, ИмяКорневойПапки, ПутьКБазе) Экспорт

	Если ПустаяСтрока(ИмяКорневойПапки) Тогда
		ВызватьИсключение "Не задано имя корневой папки списка баз";
	КонецЕсли;
	Если Найти(ИмяКорневойПапки, "/") > 0 Тогда
		ВызватьИсключение "Имя корневой папки списка баз не должно содержать символ /";
	КонецЕсли;
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ВызватьИсключение "Не задан путь к информационной базе";
	КонецЕсли;

	ФайлСписка = Новый Файл(ПутьКФайлу);
	Если Не ФайлСписка.Существует() Тогда
		Возврат;
	КонецЕсли;

	Секции = ПрочитатьСекции(ПутьКФайлу);
	ПроверитьУникальность(Секции);
	ОжидаемыйПуть = НРег((Новый Файл(ПутьКБазе)).ПолноеИмя);
	ПутьКорневойПапки = "/" + ИмяКорневойПапки;
	ЗаписьУдалена = Ложь;
	ПапкиУдаленныхЗаписей = Новый Соответствие;
	Индекс = Секции.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Секция = Секции[Индекс];
		Подключение = ПолучитьСвойство(Секция, "Connect");
		Папка = ПолучитьСвойство(Секция, "Folder");
		Если Подключение <> Неопределено
			И Папка <> Неопределено
			И ПодключениеСоответствуетПути(Подключение, ОжидаемыйПуть)
			И ПапкаПринадлежитКорневой(Папка, ПутьКорневойПапки) Тогда
			ПапкиУдаленныхЗаписей.Вставить(НРег(Папка), Папка);
			Секции.Удалить(Индекс);
			ЗаписьУдалена = Истина;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Если ЗаписьУдалена Тогда
		Для Каждого ЭлементПапки Из ПапкиУдаленныхЗаписей Цикл
			УдалитьПустуюПапкуПоПути(Секции, ЭлементПапки.Значение, ПутьКорневойПапки);
		КонецЦикла;
		ПроверитьУникальность(Секции);
		ЗаписатьСекции(ПутьКФайлу, Секции);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаДанных

Процедура ПроверитьПараметры(ИмяКорневойПапки, ИмяWorktree, ПутьКБазе)

	Если ПустаяСтрока(ИмяКорневойПапки) Тогда
		ВызватьИсключение "Не задано имя корневой папки списка баз";
	КонецЕсли;
	Если Найти(ИмяКорневойПапки, "/") > 0 Тогда
		ВызватьИсключение "Имя корневой папки списка баз не должно содержать символ /";
	КонецЕсли;
	Если ПустаяСтрока(ИмяWorktree) Тогда
		ВызватьИсключение "Не задано имя worktree";
	КонецЕсли;
	Если ПустаяСтрока(ПутьКБазе) Тогда
		ВызватьИсключение "Не задан путь к информационной базе";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьУникальность(Секции)

	Имена = Новый Соответствие;
	Идентификаторы = Новый Соответствие;
	Для Каждого Секция Из Секции Цикл
		КлючИмени = НРег(Секция.Имя);
		Если Имена.Получить(КлючИмени) <> Неопределено Тогда
			ВызватьИсключение "В списке баз обнаружено повторяющееся имя секции: " + Секция.Имя;
		КонецЕсли;
		Имена.Вставить(КлючИмени, Истина);

		Идентификатор = ПолучитьСвойство(Секция, "ID");
		Если Идентификатор <> Неопределено Тогда
			КлючИдентификатора = НРег(Идентификатор);
			Если Идентификаторы.Получить(КлючИдентификатора) <> Неопределено Тогда
				ВызватьИсключение "В списке баз обнаружен повторяющийся ID: " + Идентификатор;
			КонецЕсли;
			Идентификаторы.Вставить(КлючИдентификатора, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЧтоСекцияПапка(Секция)

	Если ПолучитьСвойство(Секция, "Connect") <> Неопределено Тогда
		ВызватьИсключение "Секция с именем папки уже описывает информационную базу: " + Секция.Имя;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЧтоСекцияБаза(Секция)

	Если ПолучитьСвойство(Секция, "Connect") = Неопределено Тогда
		ВызватьИсключение "Секция с именем базы уже описывает папку: " + Секция.Имя;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеИЗапись

Функция ПрочитатьСекции(ПутьКФайлу)

	Секции = Новый Массив;
	ФайлСписка = Новый Файл(ПутьКФайлу);
	Если Не ФайлСписка.Существует() Тогда
		Возврат Секции;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекущаяСекция = Неопределено;
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Если ЭтоЗаголовокСекции(СтрокаФайла) Тогда
			ТекущаяСекция = Новый Структура("Имя,Строки", Сред(СтрокаФайла, 2, СтрДлина(СтрокаФайла) - 2), Новый Массив);
			Секции.Добавить(ТекущаяСекция);
		ИначеЕсли ТекущаяСекция <> Неопределено Тогда
			ТекущаяСекция.Строки.Добавить(СтрокаФайла);
		ИначеЕсли Не ПустаяСтрока(СтрокаФайла) Тогда
			Чтение.Закрыть();
			ВызватьИсключение "До первой секции ibases.v8i обнаружены неизвестные данные";
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Секции;

КонецФункции

Процедура ЗаписатьСекции(ПутьКФайлу, Секции)

	КаталогФайла = Новый Файл(ПутьКФайлу);
	Если Не КаталогФайла.Существует() Тогда
		СоздатьКаталог(КаталогФайла.Путь);
	КонецЕсли;

	ПутьВременногоФайла = ПутьКФайлу + ".tmp";
	Запись = Новый ЗаписьТекста(ПутьВременногоФайла, КодировкаТекста.UTF8);
	Для ИндексСекции = 0 По Секции.Количество() - 1 Цикл
		Секция = Секции[ИндексСекции];
		Запись.ЗаписатьСтроку("[" + Секция.Имя + "]");
		Для Каждого СтрокаСекции Из Секция.Строки Цикл
			Запись.ЗаписатьСтроку(СтрокаСекции);
		КонецЦикла;
	КонецЦикла;
	Запись.Закрыть();

	КопироватьФайл(ПутьВременногоФайла, ПутьКФайлу);
	УдалитьФайлы(ПутьВременногоФайла);

КонецПроцедуры

Функция ЭтоЗаголовокСекции(СтрокаФайла)

	Возврат СтрДлина(СтрокаФайла) >= 2
		И Лев(СтрокаФайла, 1) = "["
		И Прав(СтрокаФайла, 1) = "]";

КонецФункции

#КонецОбласти

#Область РаботаССекциями

Функция НайтиСекцию(Секции, ИмяСекции)

	Для Каждого Секция Из Секции Цикл
		Если НРег(Секция.Имя) = НРег(ИмяСекции) Тогда
			Возврат Секция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НайтиБазуПоПути(Секции, ПутьКБазе)

	ОжидаемоеПодключение = НРег("File=""" + ПутьКБазе + """;");
	Для Каждого Секция Из Секции Цикл
		Подключение = ПолучитьСвойство(Секция, "Connect");
		Если Подключение <> Неопределено И НРег(Подключение) = ОжидаемоеПодключение Тогда
			Возврат Секция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НайтиБазуВПапкеПоБазовомуИмени(Секции, ПутьПапки, БазовоеИмя)

	Для Каждого Секция Из Секции Цикл
		Подключение = ПолучитьСвойство(Секция, "Connect");
		Папка = ПолучитьСвойство(Секция, "Folder");
		Если Подключение <> Неопределено
			И Папка <> Неопределено
			И НРег(Папка) = НРег(ПутьПапки)
			И ЭтоБазовоеИлиНумерованноеИмя(Секция.Имя, БазовоеИмя) Тогда
			Возврат Секция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НайтиПапкуВПапкеПоБазовомуИмени(Секции, ПутьРодительскойПапки, БазовоеИмя)

	Для Каждого Секция Из Секции Цикл
		Подключение = ПолучитьСвойство(Секция, "Connect");
		Папка = ПолучитьСвойство(Секция, "Folder");
		Если Подключение = Неопределено
			И Папка <> Неопределено
			И НРег(Папка) = НРег(ПутьРодительскойПапки)
			И ЭтоБазовоеИлиНумерованноеИмя(Секция.Имя, БазовоеИмя) Тогда
			Возврат Секция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЭтоБазовоеИлиНумерованноеИмя(ИмяСекции, БазовоеИмя)

	Если НРег(ИмяСекции) = НРег(БазовоеИмя) Тогда
		Возврат Истина;
	КонецЕсли;

	Префикс = НРег(БазовоеИмя) + "_";
	Если Лев(НРег(ИмяСекции), СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Ложь;
	КонецЕсли;

	Суффикс = Сред(ИмяСекции, СтрДлина(Префикс) + 1);
	Если ПустаяСтрока(Суффикс) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Число(Суффикс) > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПапкаПринадлежитКорневой(Папка, ПутьКорневойПапки)

	НормализованнаяПапка = НРег(Папка);
	НормализованныйКорень = НРег(ПутьКорневойПапки);
	Возврат НормализованнаяПапка = НормализованныйКорень
		Или Лев(НормализованнаяПапка, СтрДлина(НормализованныйКорень) + 1)
			= НормализованныйКорень + "/";

КонецФункции

Функция ПодключениеСоответствуетПути(Подключение, ОжидаемыйПуть)

	Если Лев(НРег(Подключение), 6) <> "file="""
		Или Прав(Подключение, 2) <> """;" Тогда
		Возврат Ложь;
	КонецЕсли;
	ПутьИзПодключения = Сред(Подключение, 7, СтрДлина(Подключение) - 8);
	Возврат НРег((Новый Файл(ПутьИзПодключения)).ПолноеИмя) = ОжидаемыйПуть;

КонецФункции

Процедура УдалитьПустуюПапкуПоПути(Секции, ПутьПапки, ПутьКорневойПапки)

	Если НРег(ПутьПапки) = НРег(ПутьКорневойПапки)
		Или Не ПапкаПринадлежитКорневой(ПутьПапки, ПутьКорневойПапки) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Секция Из Секции Цикл
		ПапкаСекции = ПолучитьСвойство(Секция, "Folder");
		Если ПапкаСекции <> Неопределено
			И НРег(ПапкаСекции) = НРег(ПутьПапки) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По Секции.Количество() - 1 Цикл
		Секция = Секции[Индекс];
		Если ПолучитьСвойство(Секция, "Connect") = Неопределено
			И НРег(ПолныйПутьПапки(Секция)) = НРег(ПутьПапки) Тогда
			Секции.Удалить(Индекс);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолныйПутьПапки(Секция)

	РодительскаяПапка = ПолучитьСвойство(Секция, "Folder");
	Если РодительскаяПапка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если РодительскаяПапка = "/" Тогда
		Возврат РодительскаяПапка + Секция.Имя;
	КонецЕсли;
	Возврат РодительскаяПапка + "/" + Секция.Имя;

КонецФункции

Функция ПолучитьУникальноеИмяСекции(Секции, БазовоеИмя)

	Если НайтиСекцию(Секции, БазовоеИмя) = Неопределено Тогда
		Возврат БазовоеИмя;
	КонецЕсли;

	Номер = 1;
	Пока Истина Цикл
		ИмяКандидат = БазовоеИмя + "_" + Строка(Номер);
		Если НайтиСекцию(Секции, ИмяКандидат) = Неопределено Тогда
			Возврат ИмяКандидат;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

КонецФункции

Функция СоздатьПапку(Секции, ИмяПапки, РодительскаяПапка)

	Секция = НоваяСекция(ИмяПапки);
	Секция.Строки.Добавить("ID=" + Строка(Новый УникальныйИдентификатор));
	Секция.Строки.Добавить("OrderInList=-1");
	Секция.Строки.Добавить("Folder=" + РодительскаяПапка);
	Секция.Строки.Добавить("OrderInTree=" + Строка(СледующийПорядокВДереве(Секции)));
	Секция.Строки.Добавить("External=0");
	Секции.Добавить(Секция);
	Возврат Секция;

КонецФункции

Функция СоздатьБазу(Секции, ИмяБазы, ПутьКБазе, ПутьПапки)

	Секция = НоваяСекция(ИмяБазы);
	Секция.Строки.Добавить("Connect=File=""" + ПутьКБазе + """;");
	Секция.Строки.Добавить("ID=" + Строка(Новый УникальныйИдентификатор));
	Секция.Строки.Добавить("OrderInList=" + Строка(СледующийПорядокВСписке(Секции)));
	Секция.Строки.Добавить("Folder=" + ПутьПапки);
	Секция.Строки.Добавить("OrderInTree=" + Строка(СледующийПорядокВДереве(Секции)));
	Секция.Строки.Добавить("External=0");
	Секция.Строки.Добавить("ClientConnectionSpeed=Normal");
	Секция.Строки.Добавить("App=ThinClient");
	Секция.Строки.Добавить("WA=1");
	Секция.Строки.Добавить("Version=8.3");
	Секции.Добавить(Секция);
	Возврат Секция;

КонецФункции

Функция НоваяСекция(ИмяСекции)

	Возврат Новый Структура("Имя,Строки", ИмяСекции, Новый Массив);

КонецФункции

Функция ПолучитьСвойство(Секция, ИмяСвойства)

	Префикс = НРег(ИмяСвойства) + "=";
	Для Каждого СтрокаСекции Из Секция.Строки Цикл
		Если Лев(НРег(СтрокаСекции), СтрДлина(Префикс)) = Префикс Тогда
			Возврат Сред(СтрокаСекции, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура УстановитьСвойство(Секция, ИмяСвойства, Значение)

	Префикс = НРег(ИмяСвойства) + "=";
	Для Индекс = 0 По Секция.Строки.Количество() - 1 Цикл
		Если Лев(НРег(Секция.Строки[Индекс]), СтрДлина(Префикс)) = Префикс Тогда
			Секция.Строки[Индекс] = ИмяСвойства + "=" + Значение;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Секция.Строки.Добавить(ИмяСвойства + "=" + Значение);

КонецПроцедуры

Функция СледующийПорядокВДереве(Секции)

	Максимум = 0;
	Для Каждого Секция Из Секции Цикл
		Значение = ПолучитьСвойство(Секция, "OrderInTree");
		Если Значение <> Неопределено Тогда
			Попытка
				Максимум = Макс(Максимум, Число(Значение));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Максимум + 256;

КонецФункции

Функция СледующийПорядокВСписке(Секции)

	Максимум = 0;
	Для Каждого Секция Из Секции Цикл
		Значение = ПолучитьСвойство(Секция, "OrderInList");
		Если Значение <> Неопределено Тогда
			Попытка
				Максимум = Макс(Максимум, Число(Значение));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Максимум + 16384;

КонецФункции

#КонецОбласти
